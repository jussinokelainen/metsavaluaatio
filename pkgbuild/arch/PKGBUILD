# Maintainer: Jussi Nokelainen <jussinoke@gmail.com>
pkgname='metsavaluaatio'
pkgver=0.1.1
pkgrel=1
pkgdesc='Työkalu metsän analysointiin'
arch=('x86_64')
url="https://github.com/jussinokelainen/$pkgname"
license=('AGPL-3.0-only')
depends=('glibc' 'gcc-libs' 'sqlite')
makedepends=('git' 'cargo' 'cmake' 'sqlite')
source=("$pkgname-$pkgver.tar.gz::https://github.com/jussinokelainen/$pkgname/archive/refs/tags/$pkgver.tar.gz")
options=('!debug' '!lto')
sha256sums=('SKIP')

prepare() {
	cd "$pkgname-$pkgver"
	cargo fetch --locked
}

build() {
	cd "$pkgname-$pkgver"
	export CARGO_TARGET_DIR=target
	cargo build --release --frozen
}

package() {
	cd "$pkgname-$pkgver"
	install -Dm755 target/release/metsaval "$pkgdir/usr/bin/metsaval"
}
