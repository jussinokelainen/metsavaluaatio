# Maintainer: Jussi Nokelainen <jussinoke@gmail.com>
_pkgname='metsavaluaatio'
pkgname="$_pkgname-git"
pkgver=r17.910b447
pkgrel=1
pkgdesc='Työkalu metsän analysointiin'
arch=('x86_64')
url="https://github.com/jussinokelainen/metsavaluaatio"
license=('AGPL-3.0-only')
depends=('glibc' 'gcc-libs' 'sqlite')
makedepends=('git' 'cargo' 'cmake' 'sqlite')
source=("$_pkgname::git+https://github.com/jussinokelainen/metsavaluaatio.git")
options=('!debug' '!lto')
sha256sums=('SKIP')

pkgver() {
	cd "$_pkgname"
	printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
	cd "$_pkgname"
	cargo fetch --locked
}

build() {
	cd "$_pkgname"
	export CARGO_TARGET_DIR=target
	cargo build --release --frozen
}

package() {
	cd "$_pkgname"
	install -Dm755 target/release/metsaval "$pkgdir/usr/bin/metsaval"
}
